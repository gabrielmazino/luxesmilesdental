@model LuxeSmilesDental.Models.Appointment
@{
    ViewData["Title"] = "Appointment Details";
}

<div class="recall-container">
    <div class="inventory-header">
        <h1>Appointment Details</h1>
        <div>
            <a href="@Url.Action("Index", "Calendar")" class="btn-secondary">Back to Calendar</a>
        </div>
    </div>

    <div class="recall-details-grid">
        <div class="card">
            <div class="card-header">
                <h4>Appointment Information</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt>Patient</dt>
                    <dd>
                        @if (Model.Patient != null)
                        {
                            <a href="@Url.Action("Details", "Patients", new { id = Model.PatientId })" class="text-primary">
                                @Model.Patient.FirstName @Model.Patient.LastName
                            </a>
                        }
                        else
                        {
                            @Model.PatientName
                        }
                    </dd>

                    @if (Model.Patient?.ContactNumber != null)
                    {
                        <dt>Phone</dt>
                        <dd>@Model.Patient.ContactNumber</dd>
                    }

                    @if (Model.Patient?.Email != null)
                    {
                        <dt>Email</dt>
                        <dd>@Model.Patient.Email</dd>
                    }

                    <dt>Dentist</dt>
                    <dd>@(Model.Dentist?.EmployeeName ?? "N/A")</dd>

                    <dt>Date & Time</dt>
                    <dd>@Model.AppointmentDate.ToString("MMMM dd, yyyy hh:mm tt")</dd>

                    <dt>Status</dt>
                    <dd>
                        <span class="badge bg-success">@Model.Status</span>
                    </dd>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <dt>Notes</dt>
                        <dd>@Model.Notes</dd>
                    }

                    <dt>Created</dt>
                    <dd>@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</dd>
                </dl>
            </div>
        </div>

        <div>
            <div class="card">
                <div class="card-header">
                    <h4>Actions</h4>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("Index", "Calendar", new { year = Model.AppointmentDate.Year, month = Model.AppointmentDate.Month })" class="btn-primary w-100 mb-2">
                        View Calendar
                    </a>
                    <button onclick="editAppointment(@Model.AppointmentId)" class="btn-primary w-100 mb-2">
                        Edit Appointment
                    </button>
                    <button onclick="deleteAppointment(@Model.AppointmentId)" class="btn-secondary w-100">
                        Delete Appointment
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
    function editAppointment(id) {
        window.location.href = '@Url.Action("Index", "Calendar", new { year = Model.AppointmentDate.Year, month = Model.AppointmentDate.Month })' + '#edit-' + id;
    }

    function deleteAppointment(id) {
        if (!confirm('Are you sure you want to delete this appointment?')) return;

        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch('/Calendar/DeleteAppointment', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ id: id })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Appointment deleted successfully');
                window.location.href = '@Url.Action("Index", "Calendar")';
            } else {
                alert('Error: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Network error occurred');
        });
    }
</script>
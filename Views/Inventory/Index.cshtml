@model List<LuxeSmilesDental.Models.InventoryItem>
@{
    ViewData["Title"] = "Inventory";
    var userRole = Context.Session.GetString("Role");
    var canModify = userRole == "Dentist" || userRole == "Dental Assistant";
}

<div class="inventory-container">
    <div class="inventory-header">
        <h1>Inventory</h1>
        @if (canModify)
        {
            <button class="btn-primary" onclick="showAddItemModal()">Add Item</button>
        }
    </div>

    <div class="search-filters">
        <form method="get" class="filter-form">
            <input type="text" name="searchItem" placeholder="Search Item" value="@Context.Request.Query["searchItem"]" />
            <select name="category">
                <option value="">Select Category</option>
                <option value="PPE">PPE</option>
                <option value="Consumables">Consumables</option>
                <option value="Equipment">Equipment</option>
                <option value="Other">Other</option>
            </select>
            <input type="text" name="supplier" placeholder="Select Supplier" value="@Context.Request.Query["supplier"]" />
            <select name="status">
                <option value="">Select Status</option>
                <option value="In Stock">In Stock</option>
                <option value="Low">Low</option>
            </select>
            <button type="submit" class="btn-primary">Find</button>
        </form>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Item Name</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Minimum Stock</th>
                <th>Supplier</th>
                <th>Status</th>
                @if (canModify)
                {
                    <th>Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Category</td>
                    <td>@item.Quantity</td>
                    <td>@item.Unit</td>
                    <td>@item.MinimumStock</td>
                    <td>@item.Supplier</td>
                    <td><span class="status-badge @(item.Status == "Low" ? "status-low" : "status-instock")">@(item.Status == "Low" ? "⚠ Low" : "✓ In Stock")</span></td>
                    @if (canModify)
                    {
                        <td>
                            <button class="icon-btn" onclick="editItem(@item.ItemId)">✏️</button>
                            @if (userRole == "Dentist")
                            {
                                <button class="icon-btn" onclick="deleteItem(@item.ItemId)">🗑️</button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@if (canModify)
{
    <div id="itemModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeItemModal()">&times;</span>
            <h2 id="modalTitle">Add Item</h2>
            <form id="itemForm">
                <input type="hidden" id="itemId" />
                <div class="form-group">
                    <label>Item Name</label>
                    <input type="text" id="itemName" required />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select id="category" required>
                        <option value="PPE">PPE</option>
                        <option value="Consumables">Consumables</option>
                        <option value="Equipment">Equipment</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Quantity</label>
                    <input type="number" id="quantity" required />
                </div>
                <div class="form-group">
                    <label>Unit</label>
                    <input type="text" id="unit" required />
                </div>
                <div class="form-group">
                    <label>Minimum Stock</label>
                    <input type="number" id="minimumStock" required />
                </div>
                <div class="form-group">
                    <label>Supplier</label>
                    <input type="text" id="supplier" required />
                </div>
                <button type="submit" class="btn-primary">Save</button>
            </form>
        </div>
    </div>

    <script>
        var canDelete = @(userRole == "Dentist" ? "true" : "false");
    </script>
    <script src="~/js/inventory.js"></script>
}
else
{
    <div style="background: #fff3cd; color: #856404; padding: 15px; border-radius: 8px; margin-top: 20px;">
        <strong>Note:</strong> You have read-only access to inventory. Contact a Dentist or Dental Assistant to modify items.
    </div>
}

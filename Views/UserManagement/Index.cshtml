@model IEnumerable<LuxeSmilesDental.Models.User>
@{
    ViewData["Title"] = "User Management";
}
<div class="user-management-container">
    <div class="inventory-header">
        <h1>User Management</h1>
        <button class="btn-primary" onclick="showAddUserModal()">Add New User</button>
    </div>
    <div class="white-card-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Employee Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Contact Number</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="@(user.IsActive ? "" : "inactive-user")">
                        <td><strong>@user.EmployeeName</strong></td>
                        <td>@user.Username</td>
                        <td>
                            <span class="status-badge role-badge">
                                @user.Role
                            </span>
                        </td>
                        <td>@(user.ContactNumber ?? "-")</td>
                        <td>
                            <label class="toggle-switch">
                                <input type="checkbox" @(user.IsActive ? "checked" : "") onchange="toggleUserStatus(@user.UserId)" />
                                <span class="slider"></span>
                            </label>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="icon-btn edit-btn" onclick="editUser(@user.UserId)">Edit</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add/Edit User Modal -->
<div id="userModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeUserModal()">&times;</span>
        <h2 id="modalTitle">Add User</h2>
        <form id="userForm">
            <input type="hidden" id="userId" />
            <div class="form-group">
                <label>Employee Name</label>
                <input type="text" id="employeeName" required />
            </div>
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="username" required />
            </div>
            <div class="form-group" id="passwordGroup" style="display: none;">
                <label id="passwordLabel">Password</label>
                <input type="password" id="password" placeholder="Enter password" />
                <small id="passwordHint" style="color: #888; display: none;">Leave blank to keep current password</small>
            </div>
            <div class="form-group">
                <label>Role</label>
                <select id="role" required>
                    <option value="Dentist">Dentist</option>
                    <option value="Dental Assistant">Dental Assistant</option>
                    <option value="Secretary">Secretary</option>
                </select>
            </div>
            <div class="form-group">
                <label>Contact Number (Optional)</label>
                <input type="text" id="contactNumber" placeholder="e.g., +63 912 345 6789" />
            </div>
            <button type="submit" class="btn-primary">Save</button>
        </form>
    </div>
</div>
@Html.AntiForgeryToken()
<script src="~/js/usermanagement.js"></script>

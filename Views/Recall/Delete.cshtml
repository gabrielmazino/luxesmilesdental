@model LuxeSmilesDental.Models.PatientRecall
@{
    ViewData["Title"] = "Delete Recall";
}

<div class="container mt-4">
    <h2>Delete Patient Recall</h2>
    <hr />

    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this recall?</h4>
        <p>This action cannot be undone.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Patient</dt>
                <dd class="col-sm-9">@Model.Patient.FullName</dd>

                <dt class="col-sm-3">Recall Case</dt>
                <dd class="col-sm-9">@Model.RecallCase</dd>

                <dt class="col-sm-3">Previous Visit</dt>
                <dd class="col-sm-9">
                    @if (Model.PreviousVisitDate.HasValue)
                    {
                        @Model.PreviousVisitDate.Value.ToString("MMMM dd, yyyy")
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </dd>

                <dt class="col-sm-3">Recall Date</dt>
                <dd class="col-sm-9">@Model.RecallDate.ToString("MMMM dd, yyyy")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == "Recall Overdue")
                    {
                        <span class="badge bg-danger">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                </dd>

                <dt class="col-sm-3">Created On</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="RecallId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

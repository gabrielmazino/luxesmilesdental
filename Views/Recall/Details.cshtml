@model LuxeSmilesDental.Models.PatientRecall
@{
    ViewData["Title"] = "Recall Details";
    var daysUntil = (Model.RecallDate - DateTime.Today).Days;
}

<div class="recall-container">
    <div class="inventory-header">
        <h1>Recall Details</h1>
        <div style="display: flex; gap: 12px;">
            <a href="@Url.Action("Edit", "Recall", new { id = Model.RecallId })" class="btn-warning">Edit Recall</a>
            <a href="@Url.Action("Index", "Recall")" class="btn-secondary">Back to List</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>@Model.RecallCase</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Patient</dt>
                        <dd class="col-sm-8">
                            <a href="@Url.Action("Details", "Patients", new { id = Model.PatientId })" style="color: var(--secondary-teal); text-decoration: none; font-weight: 600;">
                                @Model.Patient.FullName
                            </a>
                        </dd>

                        <dt class="col-sm-4">Recall Case</dt>
                        <dd class="col-sm-8">@Model.RecallCase</dd>

                        <dt class="col-sm-4">Previous Visit Date</dt>
                        <dd class="col-sm-8">
                            @if (Model.PreviousVisitDate.HasValue)
                            {
                                @Model.PreviousVisitDate.Value.ToString("MMMM dd, yyyy")
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Recall Date</dt>
                        <dd class="col-sm-8">
                            <strong>@Model.RecallDate.ToString("MMMM dd, yyyy")</strong>
                            @if (daysUntil < 0)
                            {
                                <br />
                                <span class="text-danger">(@Math.Abs(daysUntil) days overdue)</span>
                            }
                            else if (daysUntil == 0)
                            {
                                <br />
                                <span class="text-warning fw-bold">(Today)</span>
                            }
                            else
                            {
                                <br />
                                <span class="text-success">(In @daysUntil days)</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Recall Overdue")
                            {
                                <span class="badge bg-danger fs-6">@Model.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-success fs-6">@Model.Status</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created On</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</dd>
                    </dl>
                </div>
            </div>

            @if (Model.Status == "Recall Overdue")
            {
                <div class="alert alert-danger">
                    <h5>⚠️ This recall is overdue!</h5>
                    <p>The patient was scheduled to return @Math.Abs(daysUntil) days ago.</p>
                    <p class="mb-0">
                        <a href="@Url.Action("Edit", "Recall", new { id = Model.RecallId })" class="btn-warning">
                            Reschedule Recall Date
                        </a>
                    </p>
                </div>
            }
            else if (daysUntil <= 7)
            {
                <div class="alert alert-warning">
                    <h5>🕐 Recall coming soon!</h5>
                    <p class="mb-0">Patient should return in @daysUntil days on @Model.RecallDate.ToString("MMMM dd, yyyy").</p>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Patient Information</h5>
                </div>
                <div class="card-body">
                    <dl>
                        <dt>Name</dt>
                        <dd>@Model.Patient.FullName</dd>

                        <dt>Contact</dt>
                        <dd>@(Model.Patient.ContactNumber ?? "N/A")</dd>

                        <dt>Email</dt>
                        <dd>@(Model.Patient.Email ?? "N/A")</dd>
                    </dl>

                    <a href="@Url.Action("Details", "Patients", new { id = Model.PatientId })" class="btn-info btn-sm w-100 mt-3">
                        View Full Patient Details
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Actions</h5>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("Edit", "Recall", new { id = Model.RecallId })" class="btn-warning w-100 mb-2">
                        ✏️ Modify Recall Date
                    </a>
                    <a href="@Url.Action("Delete", "Recall", new { id = Model.RecallId })" class="btn-danger w-100">
                        🗑️ Delete Recall
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

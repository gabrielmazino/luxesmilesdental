<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Luxe Smiles Dental Center</title>
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="main-container">
        <aside class="sidebar">
            <div class="logo">
                <img src="~/images/logo.png" alt="Luxe Smiles" />
            </div>

            <nav class="nav-menu">
                <a href="@Url.Action("Index", "Dashboard")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Dashboard" ? "active" : "")">
                    <span class="icon">📊</span>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("Index", "Patients")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Patients" ? "active" : "")">
                    <span class="icon">👥</span>
                    <span>Patients</span>
                </a>

                <a href="@Url.Action("Index", "Calendar")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Calendar" ? "active" : "")">
                    <span class="icon">📅</span>
                    <span>Calendar</span>
                </a>

                @{
                    var role = Context.Session.GetString("Role");

                    // Inventory - All staff can view, but only Dentist and Dental Assistant can modify
                    if (role == "Dentist" || role == "Dental Assistant" || role == "Secretary")
                    {
                        <a href="@Url.Action("Index", "Inventory")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Inventory" ? "active" : "")">
                            <span class="icon">📦</span>
                            <span>Inventory</span>
                        </a>
                    }
                }

                <a href="@Url.Action("Index", "Recall")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Recall" ? "active" : "")">
                    <span class="icon">🔔</span>
                    <span>Recall</span>
                </a>

                @* User Management - ONLY Dentist *@
                @if (role == "Dentist")
                {
                    <a href="@Url.Action("Index", "UserManagement")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "UserManagement" ? "active" : "")">
                        <span class="icon">👤</span>
                        <span>User Management</span>
                    </a>
                }
            </nav>

            <a href="@Url.Action("Logout", "Account")" class="logout-btn">Log out</a>
        </aside>

        <main class="content">
            <header class="top-bar">
                <h2 class="page-title">Luxe Smiles Dental Center</h2>
                <div class="user-info">
                    <span class="user-name">@Context.Session.GetString("EmployeeName")</span>
                    <span class="user-role">@Context.Session.GetString("Role")</span>
                </div>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>

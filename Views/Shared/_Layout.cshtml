<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Luxe Smiles Dental Center</title>
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div class="main-container">
        <aside class="sidebar">
            <div class="logo">
                <img src="~/images/logo.png" alt="Luxe Smiles" />
            </div>

            <nav class="nav-menu">
                <a href="@Url.Action("Index", "Dashboard")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Dashboard" ? "active" : "")">
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                    </span>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("Index", "Patients")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Patients" ? "active" : "")">
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    </span>
                    <span>Patients</span>
                </a>

                <a href="@Url.Action("Index", "Calendar")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Calendar" ? "active" : "")">
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    </span>
                    <span>Calendar</span>
                </a>

                @{
                    var role = Context.Session.GetString("Role");
                    if (role == "Dentist" || role == "Dental Assistant" || role == "Secretary")
                    {
                        <a href="@Url.Action("Index", "Inventory")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Inventory" ? "active" : "")">
                            <span class="icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                            </span>
                            <span>Inventory</span>
                        </a>
                    }
                }

                <a href="@Url.Action("Index", "Recall")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Recall" ? "active" : "")">
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                    </span>
                    <span>Recall</span>
                </a>

                @if (role == "Dentist")
                {
                    <a href="@Url.Action("Index", "UserManagement")" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "UserManagement" ? "active" : "")">
                        <span class="icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </span>
                        <span>User Management</span>
                    </a>
                }
            </nav>

            <a href="@Url.Action("Logout", "Account")" class="logout-btn">Log out</a>
        </aside>

        <main class="content">
            <header class="top-bar">
                <h2 class="page-title">Luxe Smiles Dental Center</h2>
                <div class="user-info">
                    <span class="user-name">@Context.Session.GetString("EmployeeName")</span>
                    <span class="user-role">@Context.Session.GetString("Role")</span>
                </div>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>

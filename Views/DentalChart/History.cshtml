@model IEnumerable<LuxeSmilesDental.Models.DentalChart>
@{
    ViewData["Title"] = "Chart History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chart History - @ViewBag.PatientName</h2>
        <a asp-controller="Patients" asp-action="Index" class="btn btn-secondary">Back to Patients</a>
    </div>

    <div class="row">
        @foreach (var chart in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h6>@chart.VisitDate.ToString("MMMM dd, yyyy")</h6>
                    </div>
                    <div class="card-body">
                        <img src="@chart.ImagePath" alt="Dental Chart" class="img-fluid mb-2" style="border: 1px solid #ddd;" />
                        <p class="mb-1"><strong>Created By:</strong> @chart.CreatedBy</p>
                        <p class="mb-3"><strong>Created:</strong> @chart.CreatedAt.ToString("MM/dd/yyyy")</p>
                        <a asp-action="ViewChart" asp-route-id="@chart.PatientId" class="btn btn-primary btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No dental charts found for this patient.
        </div>
    }
</div>

@model LuxeSmilesDental.Models.Patient
@{
    ViewData["Title"] = "Delete Patient";
}

<div class="container mt-4">
    <h2>Delete Patient</h2>
    <hr />

    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this patient?</h4>
        <p>This action cannot be undone. All dental charts and recalls associated with this patient will also be deleted.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Contact Number</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.ContactNumber) ? "N/A" : Model.ContactNumber)</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</dd>

                @if (Model.BirthDate.HasValue)
                {
                    <dt class="col-sm-3">Birth Date</dt>
                    <dd class="col-sm-9">@Model.BirthDate.Value.ToString("MMMM dd, yyyy")</dd>
                }

                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Notes) ? "No notes" : Model.Notes)</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="PatientId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
